# 环境变量配置模板
# 复制此文件为 .env 并填入真实的配置信息

# Neo4j 数据库配置
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# OpenAI 配置
OPENAI_API_KEY=your_openai_api_key_here
USE_OPENAI_IMAGES=true

# SiliconFlow (硅基流动) 配置
# 请在 https://siliconflow.cn 注册并获取API密钥
SILICONFLOW_KEY=your_siliconflow_api_key_here

# 豆包语音服务配置（可选）
# 请在火山引擎控制台获取：https://console.volcengine.com/speech/service
DOUBAO_APP_KEY=your_doubao_app_key_here
DOUBAO_TOKEN=your_doubao_token_here
DOUBAO_API_URL=https://openspeech.bytedance.com/api/v1/tts
DOUBAO_ENABLED=false

# SeeDance 2.0 AI 视频生成配置
# 请在第三方平台（如 laozhang.ai）或官方 Volcengine 获取 API 密钥
# 官方文档: https://www.volcengine.com/docs/6791/1133851
SEEDANCE_API_KEY=your_seedance_api_key_here
SEEDANCE_BASE_URL=https://api.laozhang.ai/v1
SEEDANCE_ENABLED=true